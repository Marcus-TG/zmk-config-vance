#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

 / {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* Row 0 */
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
                /* Row 1 */
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSLH
                /* Row 2 */
                &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp APOS
                /* Row 3 */
                &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp LBKT
                /* Row 4 */
                &kp LCTRL &trans &trans &kp LALT &kp LGUI &kp SPACE &kp BSPC &kp RET &kp RGUI &trans &kp EQUAL &kp RBKT
                /* Row 5 */
                &trans &trans &trans &trans &mo 1 &mo 2 &mo 2 &mo 1 &trans &trans &trans &trans
            >;
        };

        layer_1 {
            bindings = <
                /* Row 0 */
                &trans &trans &trans &trans &trans &trans &trans &kp NUMLOCK &kp KP_SLASH &kp KP_ASTER &kp KP_MINUS &trans
                /* Row 1 */
                &trans &kp INS &kp UP &kp END &kp PGUP &trans &trans &kp KP_7 &kp KP_8 &kp KP_9 &kp KP_PLUS &trans
                /* Row 2 */
                &trans &kp LEFT &kp DOWN &kp RIGHT &kp PGDN &trans &trans &kp KP_4 &kp KP_5 &kp KP_6 &kp KP_ENTER &trans
                /* Row 3 */
                &trans &kp PSCR &trans &kp DEL &trans &trans &kp KP_0 &kp KP_1 &kp KP_2 &kp KP_3 &kp KP_ENTER &trans
                /* Row 4 */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                /* Row 5 */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        layer_2 {
            bindings = <
                /* Row 0 */
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11
                /* Row 1 */
                &trans &kp F12 &kp VOLU &kp PLAY_PAUSE &trans &trans &trans &trans &trans &trans &trans &trans
                /* Row 2 */
                &trans &trans &kp VOLD &kp NEXT &trans &trans &trans &trans &trans &trans &trans &trans
                /* Row 3 */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                /* Row 4 */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                /* Row 5 */
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};

