#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
                &kp Y &kp U &kp I &kp O &kp P &kp BSLH
                &kp H &kp J &kp K &kp L &kp SEMI &kp APOS
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp LBKT
                &kp BSPC &kp RET &kp RGUI &trans &kp EQUAL &kp RBKT
                &mo(2) &mo(1) &trans &trans &trans &trans
            >;
        };

        layer_1 {
            bindings = <
                &kp KP_NUMLOCK &kp KP_SLASH &kp KP_ASTERISK &kp KP_MINUS &trans &trans
                &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS &trans &trans
                &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_ENTER &trans &trans
                &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER &trans &trans
                &kp KP_N0 &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        layer_2 {
            bindings = <
                &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};

