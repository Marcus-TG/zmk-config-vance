#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp 6 &kp 7 &kp 8 &kp 9 &kp 0 &kp MINUS
                &kp Y &kp U &kp I &kp O &kp P &kp BSLH
                &kp H &kp J &kp K &kp L &kp SEMI &kp APOS
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp LBKT
                &kp BSPC &kp RET &kp RGUI &trans &kp EQUAL &kp RBKT
                &trans &trans &trans &trans &trans &trans
            >;
        };

        layer_1 {
            bindings = <
                &kp NUMLOCK &kp KP_SLASH &kp KP_ASTER &kp KP_MINUS &trans &trans
                &kp KP_7 &kp KP_8 &kp KP_9 &kp KP_PLUS &trans &trans
                &kp KP_4 &kp KP_5 &kp KP_6 &kp KP_ENTER &trans &trans
                &kp KP_1 &kp KP_2 &kp KP_3 &kp KP_ENTER &trans &trans
                &kp KP_0 &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        layer_2 {
            bindings = <
                &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};

