#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC &kp 1 &kp 2 &kp 3 &kp 4 &kp 5
                &kp TAB &kp Q &kp W &kp E &kp R &kp T
                &kp CAPS &kp A &kp S &kp D &kp F &kp G
                &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B
                &kp LCTRL &trans &trans &kp LALT &kp LGUI &kp SPACE
                &trans &trans &trans &trans &mo(1) &mo(2)
            >;
        };

        layer_1 {
            bindings = <
                &trans &trans &trans &trans &trans &trans
                &trans &kp INS &kp UP &kp END &kp PGUP &trans
                &trans &kp LEFT &kp DOWN &kp RIGHT &kp PGDN &trans
                &trans &kp PSCR &trans &kp DEL &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };

        layer_2 {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};

